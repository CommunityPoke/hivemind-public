# /etc/systemd/system/pip-node.service — PIP HTTP transport
[Unit]
Description=PIP node (HTTP transport)
After=network.target

[Service]
User=pip
Group=pip
EnvironmentFile=/etc/pip-node/env
ExecStart=/opt/pip-node/.venv/bin/pip-node serve-http
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pip-node
PrivateTmp=true

[Install]
WantedBy=multi-user.target
