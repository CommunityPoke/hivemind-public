# Example PIP environment configuration (spec §12). No real secrets here.
PIP_PRIVATE_KEY_FILE=./data/instance.key
PIP_DISPLAY_NAME=poke
PIP_POLICY_FILE=./config/policy.yaml
PIP_STORE_URL=memory://
# PIP_STORE_URL=sqlite:///data/pip.db
PIP_HTTP_HOST=127.0.0.1
PIP_HTTP_PORT=8642
# PIP_PUBLIC_HTTP_URL=https://poke.example.com
# PIP_PUBLIC_MCP_URL=
# PIP_HTTP_BEARER_TOKEN=
PIP_MAX_CLOCK_SKEW_SECONDS=300
PIP_IDEMPOTENCY_TTL_SECONDS=86400
PIP_LOG_LEVEL=INFO
# PIP_ALLOW_INSECURE_KEY_PERMS=1  # tests only
